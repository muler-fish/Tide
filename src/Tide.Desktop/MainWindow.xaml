<ui:FluentWindow x:Class="Tide.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Tide.Desktop"
 Title="潮汐 · X岛" Width="1280" Height="800" MinWidth="900" MinHeight="600"
 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
 Style="{StaticResource {x:Type ui:FluentWindow}}">
  <!-- 沿用按屏幕工作区与 DPI 限制初始尺寸；窗口按钮由 WPF UI 托管。 -->
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshListCommand}"/>
    <KeyBinding Modifiers="Control" Key="R" Command="{Binding RefreshThreadCommand}"/>
    <KeyBinding Modifiers="Control" Key="D" Command="{Binding SubscriptionCommand}"/>
  </ui:FluentWindow.InputBindings>
  <ui:FluentWindow.Resources>
    <ContextMenu x:Key="PostContextMenu" x:Shared="False" Opened="PostMenu_Opened"/>
    <ContextMenu x:Key="ThreadContextMenu" x:Shared="False" Opened="ThreadMenu_Opened"/>
    <ContextMenu x:Key="ForumContextMenu" x:Shared="False" Opened="ForumMenu_Opened"/>
    <local:FloatingActionInsetConverter x:Key="FloatingActionInset"/>
    <Style x:Key="FloatingAction" TargetType="ui:Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Panel.ZIndex" Value="2"/>
    </Style>
    <!-- 版块名称与星标是并排的独立操作，收藏不会误触发跳转。 -->
    <DataTemplate x:Key="ForumRowTemplate">
      <Border x:Name="ForumRow" Background="Transparent" CornerRadius="4" Margin="0,1" ContextMenu="{StaticResource ForumContextMenu}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <Button x:Name="ForumOpenButton" Tag="{Binding}" Click="Forum_Click" Style="{StaticResource Navigation}"
                  Margin="0" Padding="26,6,4,6" FontSize="12" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Button>
          <local:ForumFavoriteToggleButton x:Name="ForumFavoriteStar" Grid.Column="1" Tag="{Binding}" Width="32" Height="32" Toggling="ForumFavorite_Toggling"
                        Opacity="0" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                        Foreground="{DynamicResource Muted}"
                        ToggleCommand="{Binding DataContext.ToggleForumFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                        ToolTip="收藏版块" AutomationProperties.Name="{Binding Name, StringFormat=收藏版块：{0}}">
            <local:ForumFavoriteToggleButton.IsChecked><MultiBinding Converter="{StaticResource ForumFavorite}" Mode="OneWay">
              <Binding Path="Key"/><Binding Path="DataContext.FavoriteForumKeys" RelativeSource="{RelativeSource AncestorType=Window}"/>
            </MultiBinding></local:ForumFavoriteToggleButton.IsChecked>
            <local:ForumFavoriteToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="StarChrome" CornerRadius="4" Background="Transparent">
                <ui:SymbolIcon Symbol="Star24" Filled="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                               FontSize="16" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StarChrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="StarChrome" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></local:ForumFavoriteToggleButton.Template>
          </local:ForumFavoriteToggleButton>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="ForumRow" Property="IsMouseOver" Value="True"><Setter TargetName="ForumFavoriteStar" Property="Opacity" Value="1"/></Trigger>
        <!-- 隐藏的星标仍可用 Tab 到达；焦点进入整行时揭示它，避免只能用鼠标收藏。 -->
        <Trigger SourceName="ForumRow" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ForumFavoriteStar" Property="Opacity" Value="1"/></Trigger>
        <Trigger SourceName="ForumFavoriteStar" Property="IsChecked" Value="True">
          <Setter TargetName="ForumFavoriteStar" Property="Opacity" Value="1"/><Setter TargetName="ForumFavoriteStar" Property="Foreground" Value="{DynamicResource FavoriteStar}"/>
          <Setter TargetName="ForumFavoriteStar" Property="ToolTip" Value="取消收藏版块"/>
          <Setter TargetName="ForumFavoriteStar" Property="AutomationProperties.Name" Value="{Binding Name, StringFormat=取消收藏版块：{0}}"/>
        </Trigger>
        <DataTrigger Value="True">
          <DataTrigger.Binding><MultiBinding Converter="{StaticResource SameValue}"><Binding Path="Key"/><Binding Path="DataContext.ActiveForumKey" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding>
          <Setter TargetName="ForumRow" Property="Background" Value="{DynamicResource AccentSoft}"/>
          <Setter TargetName="ForumOpenButton" Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="ForumOpenButton" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </ui:FluentWindow.Resources>
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="26"/></Grid.RowDefinitions>
    <!-- 跳串保留在标题栏交互区域；发串移动到对应的内容栏。 -->
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <ui:TitleBar x:Name="WindowTitleBar" Height="48" Padding="0"
                   Background="{DynamicResource Sidebar}" Foreground="{DynamicResource Text}"
                   ButtonsForeground="{DynamicResource Text}" AutomationProperties.Name="窗口标题栏">
        <ui:TitleBar.Resources>
          <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
            <Setter Property="Height" Value="48"/><Setter Property="Width" Value="44"/>
          </Style>
        </ui:TitleBar.Resources>
        <ui:TitleBar.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0">
            <Viewbox Width="20" Height="20" Margin="0,0,10,0">
              <Canvas Width="28" Height="28"><Path Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M2,10 C7,2 12,18 17,10 C20,5 23,5 26,8 M2,19 C7,11 12,27 17,19 C20,14 23,14 26,17"/></Canvas>
            </Viewbox>
            <TextBlock Text="潮汐" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="X 岛匿名版" Foreground="{DynamicResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </ui:TitleBar.Header>
        <ui:TitleBar.TrailingContent>
          <Grid Width="312" Margin="0,0,16,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
            <ui:TextBox x:Name="JumpBox" Text="{Binding JumpText, UpdateSourceTrigger=PropertyChanged}"
              PlaceholderText="串号或链接 · Ctrl+L" Height="32" AutomationProperties.Name="跳转串号或链接" KeyDown="Jump_KeyDown"/>
            <Button Grid.Column="1" Command="{Binding JumpCommand}" ToolTip="跳转到串" AutomationProperties.Name="跳转到串" Style="{StaticResource Quiet}" Margin="4,0,0,0" Padding="6">
              <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16"/>
            </Button>
          </Grid>
        </ui:TitleBar.TrailingContent>
      </ui:TitleBar>
    </Border>
    <!-- 三栏均保持独立滚动；分隔条仍可拖动，串列表与正文继续虚拟化。 -->
    <Grid x:Name="ContentColumns" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="184" MinWidth="148" MaxWidth="260"/><ColumnDefinition Width="4"/>
        <ColumnDefinition Width="320" MinWidth="240"/><ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*" MinWidth="280"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="NavigationPane" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid Margin="10,12,10,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <Button x:Name="HomeTimelineButton" Style="{StaticResource Navigation}" Click="HomeTimeline_Click" AutomationProperties.Name="综合线"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="综合线"/></StackPanel></Button>
            <Button x:Name="SubscriptionsButton" Style="{StaticResource Navigation}" Command="{Binding SubscriptionsCommand}">
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SubscriptionCount}" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Star24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="我的订阅"/></StackPanel>
              </DockPanel>
            </Button>
            <Button Style="{StaticResource Navigation}" Command="{Binding LibraryCommand}" CommandParameter="history">
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding HistoryCount}" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="最近浏览"/></StackPanel>
              </DockPanel>
            </Button>
            <Button Style="{StaticResource Navigation}" Click="Drafts_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Edit24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="草稿箱"/></StackPanel></Button>
            <Separator/>
            <TextBlock Text="版块" Style="{StaticResource MutedText}" Margin="10,0,0,6"/>
          </StackPanel>
          <!-- 滚动条靠近侧栏右边缘；内容额外预留 18 DIP，展开后的覆盖式滚动条也不会盖住星标。 -->
          <ScrollViewer x:Name="ForumScroll" Grid.Row="1" Margin="0,0,-8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:InertialScroll.IsEnabled="{Binding InertialScrolling}">
            <StackPanel Margin="0,0,18,0">
              <StackPanel x:Name="FavoriteForumsSection" Margin="0,0,0,8">
                <TextBlock Text="收藏版块" Style="{StaticResource MutedText}" Margin="10,6,0,6"/>
                <TextBlock Text="暂无收藏版块" Margin="26,0,0,6" FontSize="11" Foreground="{DynamicResource Muted}">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasFavoriteForums}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ItemsControl x:Name="FavoriteForumList" ItemsSource="{Binding FavoriteForums}" ItemTemplate="{StaticResource ForumRowTemplate}"/>
              </StackPanel>
              <ItemsControl x:Name="ForumGroupList" ItemsSource="{Binding ForumGroups}"><ItemsControl.ItemTemplate><DataTemplate>
                <Expander Header="{Binding Name}"><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ForumRowTemplate}"/></Expander>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2">
            <Separator/>
            <Button Style="{StaticResource Navigation}" Click="Cookies_Click" AutomationProperties.Name="饼干管理">
              <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Cookies24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="饼干管理"/></StackPanel>
            </Button>
            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <Button x:Name="ThemeButton" Style="{StaticResource Navigation}" Click="Theme_Click" ToolTip="{Binding ThemeLabel}" AutomationProperties.Name="切换深色模式">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon x:Name="ThemeMoon" Symbol="WeatherMoon24" Filled="{Binding IsDark}" FontSize="16" Margin="0,0,10,0">
                    <ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsDark}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FavoriteStar}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style>
                  </ui:SymbolIcon><TextBlock Text="深色模式"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Style="{StaticResource Quiet}" Click="Settings_Click" ToolTip="设置与关于" AutomationProperties.Name="设置与关于" Padding="8"><ui:SymbolIcon Symbol="Settings24" FontSize="16"/></Button>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
      <GridSplitter x:Name="NavigationSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="调整板块导航栏宽度"/>
      <Border x:Name="ListPane" Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
          <Grid Margin="16,16,12,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ListTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ui:Button x:Name="RefreshListButton" Grid.Column="1" Style="{StaticResource RefreshIconButton}" Command="{Binding RefreshListCommand}" ToolTip="刷新列表 · F5" AutomationProperties.Name="刷新串列表" VerticalAlignment="Top"><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16"/></ui:Button>
          </Grid>
          <StackPanel Grid.Row="1" Margin="16,0,16,8">
          <ComboBox x:Name="SubscriptionSelector" ItemsSource="{Binding SubscriptionAccounts}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ActiveSubscriptionKey, Mode=TwoWay}" Visibility="{Binding IsSubscriptions, Converter={StaticResource Visible}}" Margin="0,0,0,8" AutomationProperties.Name="当前订阅号"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="订阅号" Click="SubscriptionSettings_Click" Visibility="{Binding IsSubscriptions, Converter={StaticResource Visible}}" FontSize="11" MinHeight="24" Padding="6,0" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="版规 ↗" Click="Notice_Click" FontSize="11" MinHeight="24" Padding="0">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Quiet}"><Style.Triggers><DataTrigger Binding="{Binding IsLibrary}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
            <TextBlock Text="{Binding ListPageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid Height="36">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSubscriptions}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ListLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
          <TextBlock Text="{Binding SubscriptionSyncStatus}" Margin="0,6,0,0">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSubscriptions}" Value="True"/><Condition Binding="{Binding SubscriptionBusy}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <StackPanel x:Name="ListLoadingIndicator" Visibility="{Binding ListLoading, Converter={StaticResource Visible}}" Margin="0,8,0,0">
            <ProgressBar Height="4" IsIndeterminate="{x:Static SystemParameters.ClientAreaAnimation}" Value="50" Foreground="{DynamicResource Accent}"/>
            <TextBlock Text="{Binding ListLoadingText}" Margin="0,4,0,0" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          </Grid>
          </StackPanel>
          <ListBox Grid.Row="2" x:Name="ThreadList" ItemsSource="{Binding VisiblePosts}" IsSynchronizedWithCurrentItem="False" SelectionChanged="Thread_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" local:IncrementalScroll.Command="{Binding LoadMoreListCommand}" local:InertialScroll.IsEnabled="{Binding InertialScrolling}" AutomationProperties.Name="串列表">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ReadingListItem}">
              <Setter Property="ContextMenu" Value="{StaticResource ThreadContextMenu}"/>
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="Thread_RightButtonDown"/>
              <Setter Property="Margin"><Setter.Value><MultiBinding Converter="{StaticResource FloatingActionInset}">
                <Binding/><Binding Path="Items" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.ShowNewThreadAction" RelativeSource="{RelativeSource AncestorType=Window}"/>
              </MultiBinding></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Border Padding="16,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding Number}">
              <StackPanel>
                <!-- 回复数固定右对齐；窄栏时左侧元信息按原顺序换行，不挤压饼干。 -->
                <DockPanel x:Name="CardMetadata" Margin="0,0,0,8">
                  <TextBlock x:Name="CardReplies" DockPanel.Dock="Right" Text="{Binding ReplyLabel}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="8,3,0,0"/>
                  <WrapPanel>
                    <local:PostIdentity Post="{Binding Post}" ShowSage="False" Margin="0,0,8,2"/>
                    <TextBlock x:Name="CardDate" Text="{Binding DateLabel}" ToolTip="{Binding Post.Time}" AutomationProperties.Name="{Binding Post.Time}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,8,2"/>
                    <TextBlock x:Name="CardForum" Text="{Binding ForumName}" ToolTip="{Binding ForumName}" MaxWidth="140" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,2"/>
                  </WrapPanel>
                </DockPanel>
                <Border x:Name="CardSage" Background="{DynamicResource SageBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,0,6" HorizontalAlignment="Left" Visibility="{Binding Post.IsSage, Converter={StaticResource Visible}}">
                  <TextBlock Text="SAGE" Foreground="{DynamicResource OnSage}" FontSize="11" FontWeight="Bold"/>
                </Border>
                <!-- 串列表区共用正文设置；标题用字重区分，作者比正文小一号。 -->
                <local:EmojiLabel x:Name="CardTitle" Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="{Binding DataContext.ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" Visibility="{Binding HasTitle, Converter={StaticResource Visible}}"/>
                <local:EmojiLabel x:Name="CardAuthor" Text="{Binding Author}" ToolTip="{Binding Author}" FontSize="{Binding DataContext.PreviewAuthorFontSize, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" Visibility="{Binding HasAuthor, Converter={StaticResource Visible}}"/>
                <!-- 有图时放到文字右侧；无图或无图模式时由控件决定折叠/手动打开。 -->
                <DockPanel>
                  <local:PostImage DockPanel.Dock="Right" Post="{Binding Post}" ShowImages="{Binding DataContext.ShowImages, RelativeSource={RelativeSource AncestorType=Window}}" PreviewHeight="72" PreviewMaxWidth="72" MaxWidth="84" Margin="10,0,0,0"/>
                  <local:PostPreview x:Name="CardBody" Html="{Binding Post.Content}" FontSize="{Binding DataContext.ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}}">
                    <local:PostPreview.Style><Style TargetType="local:PostPreview"><Style.Triggers><DataTrigger Binding="{Binding Excerpt}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:PostPreview.Style>
                  </local:PostPreview>
                </DockPanel>
                <TextBlock Text="{Binding Progress}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,6,0,0">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Progress}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding EmptyList, Converter={StaticResource Visible}}" Margin="20">
            <TextBlock Text="暂无串" FontSize="16" HorizontalAlignment="Center"/>
            <Button x:Name="EmptyListLoadMore" Content="加载下一页" Command="{Binding LoadMoreListCommand}" Visibility="{Binding HasMoreList, Converter={StaticResource Visible}}" Margin="0,12,0,0"/>
          </StackPanel>
          <!-- 与滚动列表同级，固定在当前栏右下角；不进入任何列表项模板。 -->
          <ui:Button x:Name="NewThreadButton" Grid.Row="2" Style="{StaticResource FloatingAction}" Margin="0,0,22,16"
                     Visibility="{Binding ShowNewThreadAction, Converter={StaticResource Visible}}" Click="NewThread_Click" ToolTip="发一个串" AutomationProperties.Name="发一个串">
            <ui:SymbolIcon Symbol="Edit24" FontSize="24"/>
          </ui:Button>
          <!-- 续载状态占用固定高度，加载条出现和消失时不改变阅读视口。 -->
          <StackPanel Grid.Row="3" Margin="16,4">
            <ProgressBar Height="3" IsIndeterminate="{x:Static SystemParameters.ClientAreaAnimation}" Value="50" Visibility="{Binding ListAppending, Converter={StaticResource Visible}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="{Binding ListTailStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
              <Button Content="重试" Command="{Binding RetryListLoadCommand}" Visibility="{Binding ListAppendFailed, Converter={StaticResource Visible}}" Margin="8,0,0,0" MinHeight="24" Padding="10,2" AutomationProperties.Name="重试加载串列表"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <GridSplitter x:Name="ListSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="调整串列表区宽度"/>
      <Grid x:Name="ReaderPane" Grid.Column="4" Background="{DynamicResource Surface}">
        <Grid Visibility="{Binding HasThread, Converter={StaticResource Visible}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Padding="24,16,24,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <TextBlock x:Name="ReaderForum" Text="{Binding ReaderMeta}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock x:Name="ReaderHeading" Text="{Binding ReaderTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap"/>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="ThreadSubscriptionButton" Command="{Binding SubscriptionCommand}" ToolTip="{Binding SubscriptionLabel, StringFormat={}{0} · Ctrl+D}" AutomationProperties.Name="{Binding SubscriptionLabel}" Width="32" Height="32" Padding="6">
                    <Grid>
                    <ui:SymbolIcon Symbol="Star24" Filled="{Binding IsSubscribed}" FontSize="16">
                      <ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsSubscribed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource FavoriteStar}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="?" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource Surface}" Margin="0,0,-4,-3"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding CurrentSubscriptionKnown}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                  </Button>
                  <Button x:Name="CopyThreadLinkButton" Click="CopyThreadLink_Click" ToolTip="复制串链接" AutomationProperties.Name="复制串链接" Width="32" Height="32" Padding="6" Margin="6,0"><ui:SymbolIcon Symbol="Copy24" FontSize="16"/></Button>
                  <ui:Button x:Name="RefreshThreadButton" Command="{Binding RefreshThreadCommand}" Style="{StaticResource RefreshIconButton}" ToolTip="刷新正文 · Ctrl+R" AutomationProperties.Name="刷新正文"><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16"/></ui:Button>
                </StackPanel>
                <ToggleButton x:Name="OnlyPoButton" Content="PO" IsChecked="{Binding OnlyPo, Mode=TwoWay}" Style="{StaticResource ReaderToggle}" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="只看 PO" ToolTip="只看 PO；再次点击显示全部回复"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <!-- 库的 ListBox 模板未绑定 Padding；用外边距约束正文及滚动区域，避免楼号贴边裁切。 -->
          <ListBox Grid.Row="1" x:Name="ReaderList" ItemsSource="{Binding ReadingPosts}" ScrollViewer.VerticalScrollBarVisibility="Auto" local:IncrementalScroll.Command="{Binding LoadMoreThreadCommand}" local:IncrementalScroll.PreviousCommand="{Binding LoadPreviousThreadCommand}" local:InertialScroll.IsEnabled="{Binding InertialScrolling}" Margin="24,0" AutomationProperties.Name="串正文与回复">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Margin"><Setter.Value><MultiBinding Converter="{StaticResource FloatingActionInset}">
                <Binding/><Binding Path="Items" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="DataContext.HasThread" RelativeSource="{RelativeSource AncestorType=Window}"/>
              </MultiBinding></Setter.Value></Setter>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <!-- 连续阅读流保留楼层边界，取消每条回复的大卡片与重复内边距。 -->
              <!-- 库的滚动条覆盖内容区；右侧额外预留 12 DIP，防止引用按钮和正文贴住滚动条。 -->
              <Border x:Name="PostRow" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,16,12,16" Background="Transparent" ContextMenu="{StaticResource PostContextMenu}">
                <StackPanel>
                  <TextBlock x:Name="TipLabel" Text="Tips" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" AutomationProperties.Name="X岛提示"/>
                  <Grid x:Name="PostHeader" Margin="0,0,0,8" SizeChanged="PostHeader_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <local:PostIdentity Post="{Binding Post}" IsPo="{Binding IsPo}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" ToolTip="{Binding Post.Time}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Grid.Column="2" Content="{Binding Post.Number}" Tag="{Binding Post}" Click="Quote_Click" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="6,0" MinHeight="24" FontSize="11" ToolTip="引用此楼" AutomationProperties.Name="{Binding Post.Number, StringFormat=引用 {0}}"/>
                  </Grid>
                  <local:EmojiLabel x:Name="OriginalPostTitle" Text="{Binding DataContext.OriginalTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                    FontSize="{Binding DataContext.ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,0,8">
                    <local:EmojiLabel.Style><Style TargetType="local:EmojiLabel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOriginal}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.OriginalTitle, RelativeSource={RelativeSource AncestorType=Window}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                      </Style.Triggers>
                    </Style></local:EmojiLabel.Style>
                  </local:EmojiLabel>
                  <local:PostBody Html="{Binding Post.Content}" FontSize="{Binding DataContext.ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}}" ContextMenu="{StaticResource PostContextMenu}"/>
                  <local:PostImage Post="{Binding Post}" ShowImages="{Binding DataContext.ShowImages, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsTip}" Value="True">
                  <Setter TargetName="PostHeader" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="TipLabel" Property="Visibility" Value="Visible"/>
                  <!-- 提示沿用普通回复的留白与分隔线，不额外使用强调背景。 -->
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="{x:Static SystemParameters.ClientAreaAnimation}" Value="50" VerticalAlignment="Bottom" Visibility="{Binding ThreadAppending, Converter={StaticResource Visible}}"/>
          <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="{x:Static SystemParameters.ClientAreaAnimation}" Value="50" VerticalAlignment="Top" Visibility="{Binding ThreadPrepending, Converter={StaticResource Visible}}" AutomationProperties.Name="正在加载上一页回复"/>
          <Button Grid.Row="1" Content="重试上一页" Command="{Binding RetryPreviousThreadCommand}" Visibility="{Binding ThreadPrependFailed, Converter={StaticResource Visible}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6" Padding="12,4" AutomationProperties.Name="重试加载上一页回复"/>
          <ui:Button x:Name="ReplyButton" Grid.Row="1" Style="{StaticResource FloatingAction}" Margin="0,0,36,16"
                     Click="Reply_Click" IsEnabled="{Binding CanInteractThread}" ToolTip="参与回应" AutomationProperties.Name="参与回应">
            <ui:SymbolIcon Symbol="ArrowReply24" FontSize="24"/>
          </ui:Button>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <ui:TextBox x:Name="PageBox" Width="76" MinWidth="0" Text="{Binding PageText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="回复页码" ToolTip="输入页码并按回车" Margin="4,0" KeyDown="Page_KeyDown" PreviewMouseDown="Page_MouseDown" GotKeyboardFocus="Page_GotKeyboardFocus" HorizontalContentAlignment="Stretch" TextAlignment="Center"/>
                <Button x:Name="JumpPageButton" Content="跳转" Command="{Binding JumpPageCommand}" Padding="10,4" AutomationProperties.Name="跳转到指定回复页"/>
              </StackPanel>
              <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="{Binding ThreadPageLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ThreadTailStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <Button Content="重试" Command="{Binding RetryThreadLoadCommand}" Visibility="{Binding ThreadAppendFailed, Converter={StaticResource Visible}}" Margin="8,0,0,0" Padding="10,4" AutomationProperties.Name="重试加载回复"/>
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
        <Grid Visibility="{Binding HasNoThread, Converter={StaticResource Visible}}" Margin="28">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="选择一个串开始阅读" FontSize="20" FontWeight="SemiBold"/>
            <Button Content="全岛版规 ↗" Tag="50000001" Click="QuickThread_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          </StackPanel>
        </Grid>
        <!-- 放在 HasThread 容器外：第一次打开串也能看到，不吞掉底层控件点击。 -->
        <Border x:Name="ThreadLoadingIndicator" Visibility="{Binding ThreadOpening, Converter={StaticResource Visible}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20,12" Padding="16,10" CornerRadius="4" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="1" IsHitTestVisible="False">
          <StackPanel><ProgressBar Width="160" Height="4" IsIndeterminate="{x:Static SystemParameters.ClientAreaAnimation}" Value="50" Foreground="{DynamicResource Accent}"/><TextBlock Text="正在加载正文" Margin="0,6,0,0" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Sidebar}" Padding="12,4">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="潮汐 0.2.0 · 非官方客户端" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel>
    </Border>
    <local:FeedbackOverlay x:Name="FeedbackLayer" Grid.RowSpan="4" Panel.ZIndex="100"/>
  </Grid>
</ui:FluentWindow>



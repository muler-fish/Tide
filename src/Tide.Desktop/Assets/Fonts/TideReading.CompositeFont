<FontFamily xmlns="http://schemas.microsoft.com/winfx/2006/xaml/composite-font"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily.FamilyNames>
    <System:String xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="en-US">Tide Reading</System:String>
  </FontFamily.FamilyNames>
  <FontFamily.FamilyMaps>
    <!-- WPF 按基字符选择组合字形；这些标点需与它们附着的组合符号一起交给 Segoe UI。 -->
    <FontFamilyMap Unicode="0020,002F,003D,0300-036F,0489,200B,2019" Target="Segoe UI" />
    <FontFamilyMap Unicode="0E00-0E7F" Target="./#MiSans Thai, Global User Interface" />
    <FontFamilyMap Unicode="0E80-0EFF" Target="./#MiSans Lao, Global User Interface" />
    <FontFamilyMap Unicode="0F00-0FFF" Target="./#MiSans Tibetan, Global User Interface" />
    <!-- 所有普通文字优先使用 MiSans；备用字体只补足主字体未覆盖的字符。 -->
    <FontFamilyMap Unicode="1760-177F" Target="./#MiSans, ./#Noto Sans Tagbanwa" />
    <FontFamilyMap Unicode="1BC0-1BFF" Target="./#MiSans, ./#Noto Sans Batak" />
    <FontFamilyMap Unicode="0000-10FFFF" Target="./#MiSans, Segoe UI, Global User Interface" />
  </FontFamily.FamilyMaps>
</FontFamily>
